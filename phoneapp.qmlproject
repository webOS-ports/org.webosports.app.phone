/* Qt Creator project for running the phone app on the desktop.
 *
 * Open this file in Qt Creator and press Run. The app comes up against the
 * mocks in luneos-components/test/imports -- a mock modem, mock Synergy
 * accounts and the sample contacts and call log under qml/test -- so the whole
 * UI can be exercised without a device.
 *
 * It expects luneos-components checked out next to this repository.
 */

import QmlProject 1.1

Project {
    mainFile: "qml/main-desktop.qml"

    /* Include .qml, .js, and image files from current directory and subdirectories */
    QmlFiles {
        directory: "."
    }
    JavaScriptFiles {
        directory: "."
    }
    ImageFiles {
        directory: "."
    }
    /* The mock data files loaded through Db8Model.setTestDataFile() */
    Files {
        filter: "*.json"
        directory: "."
    }
    /* List of plugin directories passed to QML runtime */
    /* The order of the imports is of importance, as the latest one override the previous definitions */
    importPaths: [ "../luneos-components/modules", "../luneos-components/test/imports" ]

    Environment {
        /* The mock Db8Model reads its sample records with XMLHttpRequest, and
           Qt 6 refuses local-file requests unless this is set. Without it the
           app comes up with no contacts, no favourites and an empty call log. */
        QML_XHR_ALLOW_FILE_READ: "1"
    }
}
